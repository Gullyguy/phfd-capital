# Local admin. Change immediately.
PHFD_ADMIN_USER=admin
PHFD_ADMIN_PASSWORD=change-me-now

# Optional database location.
PHFD_DB_PATH=./data/phfd_capital.db

# Live provider calls are disabled by default.
LIVE_PROVIDER_MODE=false

# YouLend scaffold. Do not enable until signed agreement, credentials,
# production security, mandatory U.S. data fields, and legal review are complete.
YOULEND_BASE_URL=https://partners.staging-youlendapi.com
YOULEND_ACCESS_TOKEN=
YOULEND_API_VERSION=1.0
