rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // PHFD Capital has no client-side Firestore data path. All access flows
    // through the authenticated Cloud Run service account and the Admin SDK,
    // which is governed by IAM and does not depend on these client rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
